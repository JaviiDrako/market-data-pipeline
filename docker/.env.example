# =============================================================================
# Market Data Pipeline - Environment Configuration Example
# Copy this file to docker/.env and fill in your values.
# NEVER commit docker/.env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=marketdata

# Warehouse database name (created by init scripts)
WAREHOUSE_DB=market_data_warehouse

# -----------------------------------------------------------------------------
# Airflow Admin User (created during initialization)
# -----------------------------------------------------------------------------
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Airflow security (required for multi-container UI log serving)
# -----------------------------------------------------------------------------
# Must be the SAME value on webserver and scheduler.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__CORE__FERNET_KEY=change_me_fernet_key
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_webserver_secret_key
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://marketdata:change_me_strong_password@postgres:5432/airflow_metadata
