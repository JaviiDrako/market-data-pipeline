# PostgreSQL Database Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=passwordPostgres
POSTGRES_DB=airflow_metadata

# Warehouse Database
WAREHOUSE_DB=market_data

# Airflow Admin User
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=passwordAdmin
AIRFLOW_ADMIN_EMAIL=admin@local.dev

# Airflow Database Connection
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:passwordPostgres@postgres:5432/airflow_metadata

# Airflow Fernet Key (encryption key for sensitive data)
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AIRFLOW__CORE__FERNET_KEY=fernetKeyAirflowExample123456789=