table 'gold market_candles_bi'
	lineageTag: 538aa74d-aec2-4449-bb71-4856b9c5f12b

	/// Precio de cierre de la última vela visible en el contexto actual.
	measure 'Latest Close Price' =
			VAR _LatestTime = MAX('gold market_candles_bi'[open_time])
			RETURN
			    CALCULATE(
			        MAX('gold market_candles_bi'[close_price]),
			        KEEPFILTERS('gold market_candles_bi'[open_time] = _LatestTime)
			    )
		formatString: #,##0.00
		displayFolder: KPIs / Price
		lineageTag: d34fca4f-6948-4699-9832-7eaf443a8b97

	/// Precio de apertura de la última vela visible en el contexto actual.
	measure 'Latest Open Price' =
			VAR _LatestTime = MAX('gold market_candles_bi'[open_time])
			RETURN
			    CALCULATE(
			        MAX('gold market_candles_bi'[open_price]),
			        KEEPFILTERS('gold market_candles_bi'[open_time] = _LatestTime)
			    )
		formatString: #,##0.00
		displayFolder: KPIs / Price
		lineageTag: 0ec2c86d-4479-4365-bd3a-7ef5a322b16a

	/// Precio máximo de la última vela visible en el contexto actual.
	measure 'Latest High Price' =
			VAR _LatestTime = MAX('gold market_candles_bi'[open_time])
			RETURN
			    CALCULATE(
			        MAX('gold market_candles_bi'[high_price]),
			        KEEPFILTERS('gold market_candles_bi'[open_time] = _LatestTime)
			    )
		formatString: #,##0.00
		displayFolder: KPIs / Price
		lineageTag: 3bc1d2d7-e5fa-4b08-8439-2a02109c7e0b

	/// Precio mínimo de la última vela visible en el contexto actual.
	measure 'Latest Low Price' =
			VAR _LatestTime = MAX('gold market_candles_bi'[open_time])
			RETURN
			    CALCULATE(
			        MIN('gold market_candles_bi'[low_price]),
			        KEEPFILTERS('gold market_candles_bi'[open_time] = _LatestTime)
			    )
		formatString: #,##0.00
		displayFolder: KPIs / Price
		lineageTag: 505f2558-e4f9-4391-968b-255026e62396

	/// Marca temporal de apertura de la última vela visible.
	measure 'Latest Data Time' = MAX('gold market_candles_bi'[open_time])
		formatString: dd MMM yyyy HH:mm
		displayFolder: KPIs / Price
		lineageTag: f61d6d28-5060-4eab-a92c-e65fefc4afd2

	/// Precio de apertura de la primera vela del periodo visible.
	measure 'Period Open Price' =
			VAR _FirstTime = MIN('gold market_candles_bi'[open_time])
			RETURN
			    CALCULATE(
			        MIN('gold market_candles_bi'[open_price]),
			        KEEPFILTERS('gold market_candles_bi'[open_time] = _FirstTime)
			    )
		formatString: #,##0.00
		displayFolder: KPIs / Price
		lineageTag: 2c9f4635-1a36-4b3c-960e-8dfb368715ee

	/// Precio de cierre de la última vela del periodo visible.
	measure 'Period Close Price' =
			VAR _LastTime = MAX('gold market_candles_bi'[open_time])
			RETURN
			    CALCULATE(
			        MAX('gold market_candles_bi'[close_price]),
			        KEEPFILTERS('gold market_candles_bi'[open_time] = _LastTime)
			    )
		formatString: #,##0.00
		displayFolder: KPIs / Price
		lineageTag: b3b95b76-de38-4839-9051-104779bc072c

	/// Variación relativa entre la apertura inicial y el cierre final del periodo visible.
	measure 'Period Change %' =
			VAR _OpenPrice = [Period Open Price]
			VAR _ClosePrice = [Period Close Price]
			RETURN
			    IF(
			        ISBLANK(_OpenPrice) || _OpenPrice = 0 || ISBLANK(_ClosePrice),
			        BLANK(),
			        DIVIDE(_ClosePrice - _OpenPrice, _OpenPrice)
			    )
		formatString: 0.00%
		displayFolder: KPIs / Price
		lineageTag: 330ab895-628f-459b-95cf-7462a94fbee2

	/// Precio máximo observado dentro del contexto visible.
	measure 'Period High' = MAX('gold market_candles_bi'[high_price])
		formatString: #,##0.00
		displayFolder: KPIs / Price
		lineageTag: e12b87cb-8648-4c19-b5a9-d7f2c4d9dbdb

	/// Precio mínimo observado dentro del contexto visible.
	measure 'Period Low' = MIN('gold market_candles_bi'[low_price])
		formatString: #,##0.00
		displayFolder: KPIs / Price
		lineageTag: 072bb983-84d1-43d1-85da-6c86cfe8b732

	/// Volumen total negociado en todas las velas visibles.
	measure 'Total Volume' = SUM('gold market_candles_bi'[volume])
		displayFolder: KPIs / Volume
		lineageTag: 088be79e-9d0e-40a9-a062-03cf3178d533

		formatStringDefinition = SWITCH(TRUE(), ABS([Total Volume]) >= 1000000000, "0.00,,,B", ABS([Total Volume]) >= 1000000, "0.00,,M", ABS([Total Volume]) >= 1000, "0.00,K", "#,##0.00")

	/// Volumen correspondiente a la última vela visible.
	measure 'Latest Candle Volume' =
			VAR _LatestTime = MAX('gold market_candles_bi'[open_time])
			RETURN
			    CALCULATE(
			        SUM('gold market_candles_bi'[volume]),
			        KEEPFILTERS('gold market_candles_bi'[open_time] = _LatestTime)
			    )
		displayFolder: KPIs / Volume
		lineageTag: ad9c10b6-a852-478d-be2a-0a772b5ff45f

		formatStringDefinition = SWITCH(TRUE(), ABS([Latest Candle Volume]) >= 1000000000, "0.00,,,B", ABS([Latest Candle Volume]) >= 1000000, "0.00,,M", ABS([Latest Candle Volume]) >= 1000, "0.00,K", "#,##0.00")

	/// Volumen promedio por vela en el contexto visible.
	measure 'Average Candle Volume' = AVERAGE('gold market_candles_bi'[volume])
		displayFolder: Charts / Volume
		lineageTag: 1677113b-dedc-433c-bdfa-a8514a4d8280

		formatStringDefinition = SWITCH(TRUE(), ABS([Average Candle Volume]) >= 1000000000, "0.00,,,B", ABS([Average Candle Volume]) >= 1000000, "0.00,,M", ABS([Average Candle Volume]) >= 1000, "0.00,K", "#,##0.00")

	/// Precio de cierre explícito para visuales temporales al grano de vela.
	measure 'Close Price' = MAX('gold market_candles_bi'[close_price])
		formatString: #,##0.00
		displayFolder: Charts / Price
		lineageTag: d4234de9-1fa8-471d-aad4-7ba6fcd45550

	/// Cantidad de velas dentro del contexto visible.
	measure 'Candle Count' = COUNTROWS('gold market_candles_bi')
		formatString: #,##0
		displayFolder: Charts / Price
		lineageTag: 53106f4f-c040-463c-926f-4ecab2cccb6d

