table 'gold market_dataset_bi'
	lineageTag: 498c1487-323d-42dc-88f2-cfab06214ee6

	/// Último RSI normalizado no vacío según el contexto visible.
	measure 'Current Normalized RSI' =
			VAR _LatestTime =
			    MAXX(
			        FILTER(
			            VALUES('gold market_dataset_bi'[open_time]),
			            NOT ISBLANK(CALCULATE(MAX('gold market_dataset_bi'[rsi_normalized])))
			        ),
			        'gold market_dataset_bi'[open_time]
			    )
			RETURN
			    CALCULATE(
			        MAX('gold market_dataset_bi'[rsi_normalized]),
			        KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime)
			    )
		formatString: 0.00
		displayFolder: KPIs / Indicators
		lineageTag: e6e2f708-350f-4010-b962-de202f48493d

	/// Último ATR porcentual no vacío; el origen almacena puntos porcentuales.
	measure 'Current ATR %' =
			VAR _LatestTime =
			    MAXX(
			        FILTER(
			            VALUES('gold market_dataset_bi'[open_time]),
			            NOT ISBLANK(CALCULATE(MAX('gold market_dataset_bi'[atr_pct])))
			        ),
			        'gold market_dataset_bi'[open_time]
			    )
			RETURN
			    CALCULATE(
			        MAX('gold market_dataset_bi'[atr_pct]),
			        KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime)
			    )
		formatString: 0.00\%
		displayFolder: KPIs / Indicators
		lineageTag: a2432ec5-59d4-458a-bdaf-bf7fe64ae262

