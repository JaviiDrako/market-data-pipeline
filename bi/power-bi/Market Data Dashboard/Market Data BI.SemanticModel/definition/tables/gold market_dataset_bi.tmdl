		mode: import
		source =
				let
				    Origen = PostgreSQL.Database("192.168.100.33:5433", "market_data"),
				    gold_market_dataset_bi = Origen{[Schema="gold",Item="market_dataset_bi"]}[Data]
				in
				    gold_market_dataset_bi

	annotation PBI_ResultType = Table
