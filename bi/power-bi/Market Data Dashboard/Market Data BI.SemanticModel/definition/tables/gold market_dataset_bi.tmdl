	/// Última distancia porcentual del precio frente a EMA50; el origen almacena puntos porcentuales.
	measure 'Current Price vs EMA50 %' =
			VAR _LatestTime =
			    MAXX(
			        FILTER(
			            VALUES('gold market_dataset_bi'[open_time]),
			            NOT ISBLANK(CALCULATE(MAX('gold market_dataset_bi'[price_vs_ema50_pct])))
			        ),
			        'gold market_dataset_bi'[open_time]
			    )
			RETURN
