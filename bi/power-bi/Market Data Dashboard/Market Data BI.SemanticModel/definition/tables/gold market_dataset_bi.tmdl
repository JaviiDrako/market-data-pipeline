		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 1f050ac0-c962-49cc-9c96-5862509d8a68
		summarizeBy: none
		sourceColumn: timeframe

		annotation SummarizationSetBy = Automatic

	/// Clasificacion tecnica por fila para comparaciones de mercado y color semantico.
	column 'Bias Category' =
			VAR _ema =
			    SWITCH(
			        TRUE(),
			        [ema_bullish_alignment], 1,
			        [ema_bearish_alignment], -1,
			        0
			    )
			VAR _macd =
			    SWITCH(
			        TRUE(),
			        [macd_bullish_cross] || [macd_positive], 1,
			        [macd_bearish_cross], -1,
			        0
			    )
			VAR _rsi =
			    SWITCH(
			        TRUE(),
			        [rsi_normalized] >= 0.60, 1,
			        [rsi_normalized] <= 0.40, -1,
			        0
			    )
			VAR _bollinger =
			    SWITCH(
			        TRUE(),
			        [bollinger_breakout_up] || [bollinger_position] >= 0.60, 1,
			        [bollinger_breakout_down] || [bollinger_position] <= 0.40, -1,
			        0
			    )
			VAR _breakout =
			    SWITCH(
			        TRUE(),
			        [breakout_confirmation] && ([new_20_high] || [new_50_high]), 1,
			        [breakout_confirmation] && ([new_20_low] || [new_50_low]), -1,
			        0
			    )
			VAR _score = _ema + _macd + _rsi + _bollinger + _breakout
			RETURN
			    SWITCH(
			        TRUE(),
			        _score >= 2, "Bullish",
			        _score <= -2, "Bearish",
			        "Neutral"
			    )
		dataType: string
		lineageTag: 29ce5adc-d442-4219-9009-172a2de1576b
		summarizeBy: none

