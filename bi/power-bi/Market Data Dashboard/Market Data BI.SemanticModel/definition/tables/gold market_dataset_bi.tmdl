		displayFolder: KPIs / Indicators
		lineageTag: 512c238a-b01f-4d58-9c4e-56c3cf7cfb15

	/// Filas visibles con al menos una condición alcista; cada fila se cuenta una sola vez.
	measure 'Bullish Signal Count' =
			COUNTROWS(
			    FILTER(
			        'gold market_dataset_bi',
			        'gold market_dataset_bi'[ema_bullish_alignment] = TRUE()
			            || 'gold market_dataset_bi'[golden_cross] = TRUE()
			            || 'gold market_dataset_bi'[rsi_recovering] = TRUE()
			            || 'gold market_dataset_bi'[macd_bullish_cross] = TRUE()
			            || 'gold market_dataset_bi'[macd_positive] = TRUE()
			            || 'gold market_dataset_bi'[bollinger_breakout_up] = TRUE()
			            || 'gold market_dataset_bi'[new_20_high] = TRUE()
			            || 'gold market_dataset_bi'[new_50_high] = TRUE()
			            || 'gold market_dataset_bi'[breakout_confirmation] = TRUE()
			    )
			)
		formatString: #,##0
		displayFolder: KPIs / Signals
		lineageTag: 82399160-45a3-4b95-8329-4765ed05325f

	/// Filas visibles con al menos una condición bajista; cada fila se cuenta una sola vez.
	measure 'Bearish Signal Count' =
			COUNTROWS(
			    FILTER(
			        'gold market_dataset_bi',
			        'gold market_dataset_bi'[ema_bearish_alignment] = TRUE()
			            || 'gold market_dataset_bi'[death_cross] = TRUE()
			            || 'gold market_dataset_bi'[rsi_overbought] = TRUE()
			            || 'gold market_dataset_bi'[macd_bearish_cross] = TRUE()
			            || 'gold market_dataset_bi'[bollinger_breakout_down] = TRUE()
			            || 'gold market_dataset_bi'[new_20_low] = TRUE()
			            || 'gold market_dataset_bi'[new_50_low] = TRUE()
			    )
			)
		formatString: #,##0
		displayFolder: KPIs / Signals
		lineageTag: d6af237b-5db1-42ac-85ad-f38154796934

	/// Filas visibles sin ninguna condición alcista ni bajista.
	measure 'Neutral Signal Count' =
			COUNTROWS(
			    FILTER(
			        'gold market_dataset_bi',
			        NOT(('gold market_dataset_bi'[ema_bullish_alignment] = TRUE()
			            || 'gold market_dataset_bi'[golden_cross] = TRUE()
			            || 'gold market_dataset_bi'[rsi_recovering] = TRUE()
			            || 'gold market_dataset_bi'[macd_bullish_cross] = TRUE()
			            || 'gold market_dataset_bi'[macd_positive] = TRUE()
			            || 'gold market_dataset_bi'[bollinger_breakout_up] = TRUE()
			            || 'gold market_dataset_bi'[new_20_high] = TRUE()
			            || 'gold market_dataset_bi'[new_50_high] = TRUE()
			            || 'gold market_dataset_bi'[breakout_confirmation] = TRUE()) || ('gold market_dataset_bi'[ema_bearish_alignment] = TRUE()
			            || 'gold market_dataset_bi'[death_cross] = TRUE()
			            || 'gold market_dataset_bi'[rsi_overbought] = TRUE()
			            || 'gold market_dataset_bi'[macd_bearish_cross] = TRUE()
			            || 'gold market_dataset_bi'[bollinger_breakout_down] = TRUE()
			            || 'gold market_dataset_bi'[new_20_low] = TRUE()
			            || 'gold market_dataset_bi'[new_50_low] = TRUE()))
			    )
			)
		formatString: #,##0
		displayFolder: KPIs / Signals
		lineageTag: 8cf18374-3812-43ad-9dc6-9e4b38ad575b

	/// Proporción de filas visibles que contienen al menos una señal alcista.
	measure 'Bullish Signal Ratio %' = DIVIDE([Bullish Signal Count], COUNTROWS('gold market_dataset_bi'))
		formatString: 0.00%
		displayFolder: Charts / Signals
		lineageTag: 4707028c-2389-4eb8-b0df-0b1e9f7553e8

	/// Proporción de filas visibles que contienen al menos una señal bajista.
	measure 'Bearish Signal Ratio %' = DIVIDE([Bearish Signal Count], COUNTROWS('gold market_dataset_bi'))
		formatString: 0.00%
		displayFolder: Charts / Signals
		lineageTag: b8df19d7-fca5-4261-8c1b-3fd2c3ece3fd

	/// Promedio del RSI normalizado en el contexto visible.
	measure 'Average RSI Normalized' = AVERAGE('gold market_dataset_bi'[rsi_normalized])
		formatString: 0.00
		displayFolder: Charts / Indicators
		lineageTag: 38d59f70-2fae-4c94-8e87-eceb59f98ffd

	/// Promedio de la fortaleza MACD en el contexto visible.
	measure 'Average MACD Strength' = AVERAGE('gold market_dataset_bi'[macd_strength])
		formatString: 0.00
		displayFolder: Charts / Indicators
		lineageTag: 9426cc1d-9834-4086-8db1-f8add783ab29

	/// Promedio del histograma MACD porcentual en puntos porcentuales.
	measure 'Average MACD Histogram %' = AVERAGE('gold market_dataset_bi'[macd_histogram_pct])
		formatString: 0.00\%
		displayFolder: Charts / Indicators
		lineageTag: ff6fe46a-62c8-473c-854f-09936fe61e05

	/// Promedio del ATR porcentual en puntos porcentuales.
	measure 'Average ATR %' = AVERAGE('gold market_dataset_bi'[atr_pct])
		formatString: 0.00\%
		displayFolder: Charts / Indicators
		lineageTag: e49419ef-aff7-456a-ba37-03dfd618e4c3

	/// Serie temporal dinámica controlada por el selector de indicador técnico.
	measure 'Selected Technical Indicator' =
			VAR _Indicator =
			    SELECTEDVALUE('Technical Indicator Selector'[Indicator], "RSI Normalized")
			RETURN
			    SWITCH(
			        _Indicator,
			        "RSI Normalized", [Average RSI Normalized],
			        "MACD Strength", [Average MACD Strength],
			        "MACD Histogram", [Average MACD Histogram %],
			        "ATR %", [Average ATR %],
			        "Bollinger Position", AVERAGE('gold market_dataset_bi'[bollinger_position]),
			        "Price vs EMA50 %", AVERAGE('gold market_dataset_bi'[price_vs_ema50_pct]),
			        [Average RSI Normalized]
			    )
		formatString: 0.00
		displayFolder: Technical Analysis / Dynamic
		lineageTag: 8580bba3-afff-45ba-a737-49765e9202cc

	/// Título dinámico del gráfico principal de análisis técnico.
	measure 'Selected Technical Indicator Title' = "Evolución de " & SELECTEDVALUE('Technical Indicator Selector'[Indicator], "RSI Normalized")
		displayFolder: Technical Analysis / Dynamic
		lineageTag: cb536a29-c3c4-4ea8-a419-347cc5a48c67

	/// Puntuación técnica compuesta basada en EMA, MACD, RSI, Bollinger, distancia a EMA50 y breakouts.
	measure 'Market Bias Score' =
			VAR _LatestTime = MAX('gold market_dataset_bi'[open_time])
			VAR _EMAAlignment =
			    CALCULATE(
			        MAX('gold market_dataset_bi'[ema_alignment]),
			        KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime)
			    )
			VAR _RSI = [Current Normalized RSI]
			VAR _MACD = [Current MACD Strength]
			VAR _Bollinger = [Current Bollinger Position]
			VAR _EMA50 = [Current Price vs EMA50 %]
			VAR _BullBreak =
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                'gold market_dataset_bi',
			                'gold market_dataset_bi'[bollinger_breakout_up] = TRUE()
			                    || 'gold market_dataset_bi'[new_20_high] = TRUE()
			                    || 'gold market_dataset_bi'[new_50_high] = TRUE()
			                    || ('gold market_dataset_bi'[breakout_confirmation] = TRUE() && 'gold market_dataset_bi'[price_vs_ema50_pct] >= 0)
			            )
			        ),
			        KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime)
			    )
			VAR _BearBreak =
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                'gold market_dataset_bi',
			                'gold market_dataset_bi'[bollinger_breakout_down] = TRUE()
			                    || 'gold market_dataset_bi'[new_20_low] = TRUE()
			                    || 'gold market_dataset_bi'[new_50_low] = TRUE()
			                    || ('gold market_dataset_bi'[breakout_confirmation] = TRUE() && 'gold market_dataset_bi'[price_vs_ema50_pct] < 0)
			            )
			        ),
			        KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime)
			    )
			VAR _EMAScore = SWITCH(TRUE(), _EMAAlignment > 0, 1, _EMAAlignment < 0, -1, 0)
			VAR _MACDScore = SWITCH(TRUE(), _MACD > 0, 1, _MACD < 0, -1, 0)
			VAR _RSIScore = SWITCH(TRUE(), _RSI >= 0.20, 1, _RSI <= -0.20, -1, 0)
			VAR _BollingerScore = SWITCH(TRUE(), _Bollinger >= 0.60, 1, _Bollinger <= 0.40, -1, 0)
			VAR _EMA50Score = SWITCH(TRUE(), _EMA50 > 0, 1, _EMA50 < 0, -1, 0)
			VAR _BreakScore = SWITCH(TRUE(), _BullBreak > 0 && _BearBreak = 0, 1, _BearBreak > 0 && _BullBreak = 0, -1, 0)
			RETURN
			    _EMAScore + _MACDScore + _RSIScore + _BollingerScore + _EMA50Score + _BreakScore
		formatString: 0
		displayFolder: Technical Analysis / Bias
		lineageTag: 24e1363f-1a0f-4cb1-90bc-58708cce854c

	/// Clasificación institucional del sesgo de mercado derivada de confirmación multi-indicador.
	measure 'Market Bias' =
			VAR _Score = [Market Bias Score]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_Score), "Sin datos",
			        _Score >= 4, UNICHAR(128994) & " Strong Bullish",
			        _Score >= 1, UNICHAR(128994) & " Bullish",
			        _Score <= -4, UNICHAR(128308) & " Strong Bearish",
			        _Score <= -1, UNICHAR(128308) & " Bearish",
			        UNICHAR(9898) & " Neutral"
			    )
		displayFolder: Technical Analysis / Bias
		lineageTag: a9d1f184-831a-471f-9b54-5cb8d8c7cd4a

	/// Componente alcista de la comparación multi-timeframe.
	measure 'MTF Bullish Bias' =
			VAR _Score = [Market Bias Score]
			RETURN IF(_Score > 0, _Score, BLANK())
		formatString: 0
		displayFolder: Technical Analysis / Multi-Timeframe
		lineageTag: adb3d220-51cd-4fe2-9443-9b9db9ee36cd

	/// Componente bajista de la comparación multi-timeframe.
	measure 'MTF Bearish Bias' =
			VAR _Score = [Market Bias Score]
			RETURN IF(_Score < 0, _Score, BLANK())
		formatString: 0
		displayFolder: Technical Analysis / Multi-Timeframe
		lineageTag: 91563f56-d3c4-4680-b3a1-f859af5618b4

	/// Marcador neutral de la comparación multi-timeframe.
	measure 'MTF Neutral Bias' =
			VAR _Score = [Market Bias Score]
			RETURN IF(_Score = 0, 0.25, BLANK())
		formatString: 0.00
		displayFolder: Technical Analysis / Multi-Timeframe
		lineageTag: 0361c0ae-5054-4d32-ac86-f7190ae729d3

	/// Puntuación -1/0/1 para cada fila de la matriz de confirmación técnica.
	measure 'Signal Confirmation Score' =
			VAR _Signal = SELECTEDVALUE('Technical Signal Matrix'[Signal])
			VAR _LatestTime = MAX('gold market_dataset_bi'[open_time])
			VAR _EMAAlignment = CALCULATE(MAX('gold market_dataset_bi'[ema_alignment]), KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime))
			VAR _BullCross = CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[macd_bullish_cross] = TRUE())), KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime))
			VAR _BearCross = CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[macd_bearish_cross] = TRUE())), KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime))
			VAR _BullBreak = CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[bollinger_breakout_up] = TRUE() || 'gold market_dataset_bi'[new_20_high] = TRUE() || 'gold market_dataset_bi'[new_50_high] = TRUE() || ('gold market_dataset_bi'[breakout_confirmation] = TRUE() && 'gold market_dataset_bi'[price_vs_ema50_pct] >= 0))), KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime))
			VAR _BearBreak = CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[bollinger_breakout_down] = TRUE() || 'gold market_dataset_bi'[new_20_low] = TRUE() || 'gold market_dataset_bi'[new_50_low] = TRUE() || ('gold market_dataset_bi'[breakout_confirmation] = TRUE() && 'gold market_dataset_bi'[price_vs_ema50_pct] < 0))), KEEPFILTERS('gold market_dataset_bi'[open_time] = _LatestTime))
			VAR _MACDScore = SWITCH(TRUE(), _BullCross > 0 && _BearCross = 0, 1, _BearCross > 0 && _BullCross = 0, -1, [Current MACD Strength] > 0, 1, [Current MACD Strength] < 0, -1, 0)
			VAR _RSIScore = SWITCH(TRUE(), [Current Normalized RSI] >= 0.20, 1, [Current Normalized RSI] <= -0.20, -1, 0)
			VAR _BollingerScore = SWITCH(TRUE(), [Current Bollinger Position] >= 0.60, 1, [Current Bollinger Position] <= 0.40, -1, 0)
			VAR _BreakScore = SWITCH(TRUE(), _BullBreak > 0 && _BearBreak = 0, 1, _BearBreak > 0 && _BullBreak = 0, -1, 0)
			VAR _ResultScore = SWITCH(TRUE(), [Market Bias Score] > 0, 1, [Market Bias Score] < 0, -1, 0)
			RETURN
			    SWITCH(
			        _Signal,
			        "EMA Alignment", SWITCH(TRUE(), _EMAAlignment > 0, 1, _EMAAlignment < 0, -1, 0),
			        "MACD", _MACDScore,
			        "RSI", _RSIScore,
			        "Bollinger", _BollingerScore,
			        "Breakout", _BreakScore,
			        "Resultado", _ResultScore,
			        BLANK()
			    )
		formatString: 0
		displayFolder: Technical Analysis / Confirmation
		lineageTag: e3a88ed1-a035-41d5-810a-890b7ed4e171

	/// Etiqueta accesible con icono y texto para la matriz de confirmación.
	measure 'Signal Confirmation' =
			VAR _Score = [Signal Confirmation Score]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_Score), BLANK(),
			        _Score > 0, UNICHAR(128994) & " Alcista",
			        _Score < 0, UNICHAR(128308) & " Bajista",
			        UNICHAR(9898) & " Neutral"
			    )
		displayFolder: Technical Analysis / Confirmation
		lineageTag: f2c89440-e715-4265-bdcc-d78c84b9c52a

	/// Marcador temporal de ocurrencias para las señales técnicas seleccionadas en la leyenda.
	measure 'Signal Event Marker' =
			VAR _SignalType = SELECTEDVALUE('Technical Signal Types'[Signal Type])
			VAR _EventCount =
			    SWITCH(
			        _SignalType,
			        "MACD Bullish Cross", CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[macd_bullish_cross] = TRUE()))),
			        "MACD Bearish Cross", CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[macd_bearish_cross] = TRUE()))),
			        "Golden Cross", CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[golden_cross] = TRUE()))),
			        "Death Cross", CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[death_cross] = TRUE()))),
			        "Breakout", CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[breakout_confirmation] = TRUE() || 'gold market_dataset_bi'[bollinger_breakout_up] = TRUE() || 'gold market_dataset_bi'[bollinger_breakout_down] = TRUE()))),
			        "New High", CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[new_20_high] = TRUE() || 'gold market_dataset_bi'[new_50_high] = TRUE()))),
			        "New Low", CALCULATE(COUNTROWS(FILTER('gold market_dataset_bi', 'gold market_dataset_bi'[new_20_low] = TRUE() || 'gold market_dataset_bi'[new_50_low] = TRUE()))),
			        BLANK()
			    )
			RETURN IF(_EventCount > 0, _EventCount, BLANK())
		formatString: 0
		displayFolder: Technical Analysis / Timeline
		lineageTag: 3348ef90-0efe-4171-bdc9-407b00536e1a

	/// Cantidad de estados tecnicos visibles en el contexto actual.
	measure 'Technical State Count' = COUNTROWS('gold market_dataset_bi')
		formatString: #,##0
		displayFolder: Market Intelligence / Distribution
		lineageTag: 4d9f6dfd-e266-4f56-97b1-a1fa77136cfb

	/// Codigo de polaridad usado para aplicar color financiero por estado tecnico.
	measure 'Signal Distribution Score' =
			SWITCH(
			    SELECTEDVALUE('gold market_dataset_bi'[Bias Category]),
			    "Bullish", 1,
			    "Bearish", -1,
			    0
			)
		formatString: 0
		displayFolder: Market Intelligence / Distribution
		lineageTag: 0d765e9f-e043-4bcf-9671-4f2829896191

